# Copy this to .env and fill in real values

# Retell AI — get from dashboard.retellai.com
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxx    # create one agent per clinic or share one
RETELL_FROM_NUMBER=+14155551234           # buy a number inside Retell dashboard

# Your public URL — Retell needs to reach your webhooks
# Local dev: run `ngrok http 8000` and paste the https URL here
APP_BASE_URL=https://your-ngrok-url.ngrok.io

# One value per clinic you onboard
CLINIC_ID=clinic_001
